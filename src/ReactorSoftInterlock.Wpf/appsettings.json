      {
        "ChannelNumber": 3,
        "DisplayName": "CH3",
        "InterlockMapping": "Interlock B negative (I3-I4)",
        "Enabled": true,
        "OpenCommand": "AT+CH3=0",
        "CloseCommand": "AT+CH3=1"
      },
      {
        "ChannelNumber": 4,
        "DisplayName": "CH4",
