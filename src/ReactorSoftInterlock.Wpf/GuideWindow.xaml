<Window x:Class="ReactorSoftInterlock.Wpf.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lab Guide"
        Height="720"
        Width="860"
        MinHeight="560"
        MinWidth="680">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBox x:Name="GuideTextBox"
             Grid.Row="0"
             IsReadOnly="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Disabled"
             AcceptsReturn="True"
             FontFamily="Consolas"
             FontSize="13" />

    <Button x:Name="CloseButtonControl"
            Grid.Row="1"
            Content="Close"
            Width="100"
            HorizontalAlignment="Right"
            Margin="0,12,0,0"
            IsCancel="True" />
  </Grid>
</Window>
