<Window x:Class="ReactorSoftInterlock.Wpf.AdvancedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Relay Settings"
        Width="900"
        Height="760"
        MinWidth="860"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F7"
        ResizeMode="CanResize">
  <Window.Resources>
    <Style x:Key="CardBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="#D8E0EA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="TitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="InputStyle" TargetType="TextBox">
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="#0F62FE" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#0F62FE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock x:Name="DialogTitleText" Text="Advanced Relay Settings" FontSize="26" FontWeight="SemiBold" Foreground="#111827" />
        <TextBlock x:Name="DialogSubtitleText" Text="Engineering-only relay bank configuration for the DSD TECH SH-UR04A." Margin="0,8,0,0" Foreground="#475569" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock x:Name="BaudLabel" Style="{StaticResource LabelStyle}" Text="Baud" />
            <TextBox x:Name="BaudBox" Style="{StaticResource InputStyle}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock x:Name="AdvancedHintTitle" Style="{StaticResource LabelStyle}" Text="Scope" />
            <TextBlock x:Name="AdvancedHintText" Text="Main UI stays simple. This page is only for engineering changes." Foreground="#334155" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
        <StackPanel>
          <TextBlock x:Name="DefaultsTitleText" Style="{StaticResource TitleStyle}" Text="Defaults" />
          <TextBlock x:Name="DefaultsBodyText" Text="Restore the verified DSD four-channel command template before lab work if you are unsure." Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,12" />
          <Button x:Name="RestoreDefaultsButton" Style="{StaticResource SecondaryButtonStyle}" Content="Restore DSD Defaults" Click="RestoreDefaultsButton_Click" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="ChannelSectionTitle" Style="{StaticResource TitleStyle}" Text="Per-channel commands" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <Grid x:Name="ChannelGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="95" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeaderChannelText" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" FontWeight="SemiBold" Foreground="#334155" Text="Channel" />
            <TextBlock x:Name="HeaderMappingText" Grid.Row="0" Grid.Column="1" Margin="0,0,8,8" FontWeight="SemiBold" Foreground="#334155" Text="Mapping" />
            <TextBlock x:Name="HeaderEnabledText" Grid.Row="0" Grid.Column="2" Margin="0,0,8,8" FontWeight="SemiBold" Foreground="#334155" Text="Enabled" />
            <TextBlock x:Name="HeaderOpenText" Grid.Row="0" Grid.Column="3" Margin="0,0,8,8" FontWeight="SemiBold" Foreground="#334155" Text="Open command" />
            <TextBlock x:Name="HeaderCloseText" Grid.Row="0" Grid.Column="4" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="#334155" Text="Close command" />

            <TextBlock x:Name="Ch1Label" Grid.Row="1" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" FontWeight="SemiBold" Text="CH1" />
            <TextBlock x:Name="Ch1MappingText" Grid.Row="1" Grid.Column="1" Margin="0,0,8,10" VerticalAlignment="Center" TextWrapping="Wrap" Text="Interlock A negative (I1-I2)" />
            <CheckBox x:Name="Ch1EnabledBox" Grid.Row="1" Grid.Column="2" Margin="0,0,8,10" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBox x:Name="Ch1OpenBox" Grid.Row="1" Grid.Column="3" Margin="0,0,8,10" Padding="8,6" />
            <TextBox x:Name="Ch1CloseBox" Grid.Row="1" Grid.Column="4" Margin="0,0,0,10" Padding="8,6" />

            <TextBlock x:Name="Ch2Label" Grid.Row="2" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" FontWeight="SemiBold" Text="CH2" />
            <TextBlock x:Name="Ch2MappingText" Grid.Row="2" Grid.Column="1" Margin="0,0,8,10" VerticalAlignment="Center" TextWrapping="Wrap" Text="Interlock A positive (I5-I6)" />
            <CheckBox x:Name="Ch2EnabledBox" Grid.Row="2" Grid.Column="2" Margin="0,0,8,10" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBox x:Name="Ch2OpenBox" Grid.Row="2" Grid.Column="3" Margin="0,0,8,10" Padding="8,6" />
            <TextBox x:Name="Ch2CloseBox" Grid.Row="2" Grid.Column="4" Margin="0,0,0,10" Padding="8,6" />

            <TextBlock x:Name="Ch3Label" Grid.Row="3" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" FontWeight="SemiBold" Text="CH3" />
            <TextBlock x:Name="Ch3MappingText" Grid.Row="3" Grid.Column="1" Margin="0,0,8,10" VerticalAlignment="Center" TextWrapping="Wrap" Text="Interlock B negative (I3-I4)" />
            <CheckBox x:Name="Ch3EnabledBox" Grid.Row="3" Grid.Column="2" Margin="0,0,8,10" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBox x:Name="Ch3OpenBox" Grid.Row="3" Grid.Column="3" Margin="0,0,8,10" Padding="8,6" />
            <TextBox x:Name="Ch3CloseBox" Grid.Row="3" Grid.Column="4" Margin="0,0,0,10" Padding="8,6" />

            <TextBlock x:Name="Ch4Label" Grid.Row="4" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="CH4" />
            <TextBlock x:Name="Ch4MappingText" Grid.Row="4" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="Interlock B positive (I7-I8)" />
            <CheckBox x:Name="Ch4EnabledBox" Grid.Row="4" Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBox x:Name="Ch4OpenBox" Grid.Row="4" Grid.Column="3" Margin="0,0,8,0" Padding="8,6" />
            <TextBox x:Name="Ch4CloseBox" Grid.Row="4" Grid.Column="4" Margin="0,0,0,0" Padding="8,6" />
          </Grid>
        </ScrollViewer>
      </Grid>
    </Border>

    <DockPanel Grid.Row="3" LastChildFill="False">
      <TextBlock x:Name="FooterHintText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#475569" Text="Changes take effect after saving." />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="CancelButtonControl" Width="120" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Click="CancelButton_Click" />
        <Button x:Name="SaveButtonControl" Width="150" Style="{StaticResource PrimaryButtonStyle}" Content="Save relay settings" Click="SaveButton_Click" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
