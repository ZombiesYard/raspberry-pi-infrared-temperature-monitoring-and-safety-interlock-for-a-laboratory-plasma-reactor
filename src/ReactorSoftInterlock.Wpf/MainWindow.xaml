<Window x:Class="ReactorSoftInterlock.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="G2000 Temperature Soft Interlock"
        Width="1380"
        Height="900"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F7">
  <Window.Resources>
    <Style x:Key="CardBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="#D8E0EA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1F2937" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Background" Value="#0F62FE" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#0F62FE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="InputStyle" TargetType="TextBox">
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ComboStyle" TargetType="ComboBox">
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="White" BorderBrush="#D8E0EA" BorderThickness="0,0,0,1">
      <MenuItem x:Name="FileMenu" Header="_File">
        <MenuItem x:Name="ExportMenuItem" Header="Export CSV" Click="ExportButton_Click" />
        <Separator />
        <MenuItem x:Name="ExitMenuItem" Header="Exit" Click="ExitMenuItem_Click" />
      </MenuItem>
      <MenuItem x:Name="ToolsMenu" Header="_Tools">
        <MenuItem x:Name="SelectRoiMenuItem" Header="Select ROI" Click="SelectRoiButton_Click" />
        <MenuItem x:Name="GuideMenuItem" Header="Open Lab Guide" Click="OpenGuideButton_Click" />
        <MenuItem x:Name="AdvancedSettingsMenuItem" Header="Advanced Settings" Click="AdvancedSettingsMenuItem_Click" />
      </MenuItem>
      <MenuItem x:Name="HelpMenu" Header="_Help">
        <MenuItem x:Name="WiringNotesMenuItem" Header="Wiring Notes" Click="OpenGuideButton_Click" />
        <MenuItem x:Name="AboutMenuItem" Header="About" Click="AboutMenuItem_Click" />
      </MenuItem>
    </Menu>

    <Grid Margin="18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="20">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.0*" />
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="1.1*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock x:Name="TitleText" Text="G2000 Temperature Soft Interlock" FontSize="30" FontWeight="SemiBold" Foreground="#111827" />
            <TextBlock x:Name="SubtitleText" Text="HikmicroAnalyzer OCR -> 90 C trip -> DSD relay bank interlock" Margin="0,6,0,0" Foreground="#475569" FontSize="14" />
            <TextBlock x:Name="RawOcrText" Text="Raw OCR text appears here." TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#334155" />
            <TextBlock x:Name="AlarmReasonText" Text="" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#B00020" />
          </StackPanel>

          <Border Grid.Column="1" Margin="18,0,12,0" Background="#F8FAFC" CornerRadius="8" Padding="18">
            <StackPanel>
              <TextBlock x:Name="TemperatureCardLabel" Text="Temperature" Foreground="#64748B" />
              <TextBlock x:Name="TemperatureText" Text="NO READING" FontSize="40" FontWeight="Bold" Foreground="#111827" Margin="0,8,0,10" />
              <TextBlock x:Name="RelaySummaryLabel" Text="Relay bank" Foreground="#64748B" />
              <TextBlock x:Name="RelayBankStatusText" Text="Unknown" TextWrapping="Wrap" Foreground="#1E293B" Margin="0,8,0,0" />
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Margin="6,0,12,0" Background="#F8FAFC" CornerRadius="8" Padding="18">
            <StackPanel>
              <TextBlock x:Name="GasFlowCardLabel" Text="Gas Flow" Foreground="#64748B" />
              <TextBlock x:Name="GasFlowText" Text="--" FontSize="34" FontWeight="Bold" Foreground="#111827" Margin="0,8,0,10" />
              <TextBlock x:Name="GasFlowHintText" Text="AMC2100 actual flow" Foreground="#475569" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="3" HorizontalAlignment="Stretch">
            <TextBlock x:Name="StatusLabel" Text="Status" Foreground="#64748B" Margin="0,0,0,8" />
            <Border x:Name="StatusBadgeBorder" Background="#E2E8F0" CornerRadius="8" Padding="12">
              <TextBlock x:Name="StatusText" Text="Idle" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
            </Border>
            <TextBlock x:Name="CurrentModeLabel" Text="Current mode" Foreground="#64748B" Margin="0,18,0,8" />
            <TextBlock x:Name="CurrentModeText" Text="Monitoring control" Foreground="#1E293B" FontWeight="SemiBold" />
            <TextBlock x:Name="EngineeringHintText" Text="Engineering relay actions do not read back hardware feedback. Confirm with a multimeter." TextWrapping="Wrap" Foreground="#475569" Margin="0,18,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0">
        <TabItem x:Name="MonitorTab" Header="Monitor">
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="340" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <Border Style="{StaticResource CardBorderStyle}">
                  <StackPanel>
                    <TextBlock x:Name="ControlsCardTitle" Text="Primary Actions" Style="{StaticResource CardTitleStyle}" />

                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock x:Name="LanguageQuickLabel" Style="{StaticResource LabelStyle}" Text="Language" />
                        <ComboBox x:Name="LanguageBox" Style="{StaticResource ComboStyle}" Margin="0" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectionChanged="LanguageBox_SelectionChanged" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock x:Name="PortQuickLabel" Style="{StaticResource LabelStyle}" Text="COM Port" />
                        <TextBox x:Name="PortBox" Style="{StaticResource InputStyle}" Margin="0" />
                      </StackPanel>
                    </Grid>

                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButtonStyle}" Content="Start" Click="StartButton_Click" />
                    <Button x:Name="StopButton" Style="{StaticResource SecondaryButtonStyle}" Content="Stop" Click="StopButton_Click" />
                    <Button x:Name="ResetButton" Style="{StaticResource SecondaryButtonStyle}" Content="Reset" Click="ResetButton_Click" />
                    <Button x:Name="SelectRoiButton" Style="{StaticResource SecondaryButtonStyle}" Content="Select ROI" Click="SelectRoiButton_Click" />
                    <Button x:Name="ExportButton" Style="{StaticResource SecondaryButtonStyle}" Content="Export CSV" Click="ExportButton_Click" />
                    <Separator Margin="0,6,0,12" />
                    <Button x:Name="TestRelayButton" Style="{StaticResource SecondaryButtonStyle}" Content="Disconnect All Interlocks" Click="TestRelayButton_Click" />
                    <Button x:Name="TestRelayResetButton" Style="{StaticResource SecondaryButtonStyle}" Content="Connect All Interlocks" Click="TestRelayResetButton_Click" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                  <StackPanel>
                    <TextBlock x:Name="SettingsCardTitle" Text="Everyday Settings" Style="{StaticResource CardTitleStyle}" />

                    <TextBlock x:Name="WindowLabel" Style="{StaticResource LabelStyle}" Text="Window" />
                    <TextBox x:Name="WindowTitleBox" Style="{StaticResource InputStyle}" />

                    <TextBlock x:Name="TesseractLabel" Style="{StaticResource LabelStyle}" Text="Tesseract" />
                    <TextBox x:Name="TesseractPathBox" Style="{StaticResource InputStyle}" />

                    <TextBlock x:Name="ThresholdLabel" Style="{StaticResource LabelStyle}" Text="Threshold C" />
                    <TextBox x:Name="ThresholdBox" Style="{StaticResource InputStyle}" />

                    <TextBlock x:Name="IntervalLabel" Style="{StaticResource LabelStyle}" Text="Interval ms" />
                    <TextBox x:Name="IntervalBox" Style="{StaticResource InputStyle}" />

                    <TextBlock x:Name="RecoveryLabel" Style="{StaticResource LabelStyle}" Text="Recovery C" />
                    <TextBox x:Name="RecoveryThresholdBox" Style="{StaticResource InputStyle}" />

                    <TextBlock x:Name="StableSecondsLabel" Style="{StaticResource LabelStyle}" Text="Stable sec" />
                    <TextBox x:Name="StableSecondsBox" Style="{StaticResource InputStyle}" />

                    <CheckBox x:Name="DryRunBox" Content="Dry run relay" Margin="0,0,0,10" />
                    <CheckBox x:Name="AutoResetBox" Content="Auto reset" Margin="0,0,0,14" />

                    <Separator Margin="0,0,0,12" />
                    <TextBlock x:Name="AmcSectionTitle" Text="AMC2100 Gas Flow Control" Style="{StaticResource CardTitleStyle}" />
                    <CheckBox x:Name="AmcEnabledBox" Content="Enable AMC2100 gas stop/restore" Margin="0,0,0,10" />

                    <TextBlock x:Name="AmcPortLabel" Style="{StaticResource LabelStyle}" Text="AMC2100 COM Port" />
                    <TextBox x:Name="AmcPortBox" Style="{StaticResource InputStyle}" />

                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock x:Name="AmcBaudLabel" Style="{StaticResource LabelStyle}" Text="AMC2100 Baud" />
                        <TextBox x:Name="AmcBaudBox" Style="{StaticResource InputStyle}" Margin="0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock x:Name="AmcSlaveLabel" Style="{StaticResource LabelStyle}" Text="Slave ID" />
                        <TextBox x:Name="AmcSlaveBox" Style="{StaticResource InputStyle}" Margin="0" />
                      </StackPanel>
                    </Grid>

                    <TextBlock x:Name="AmcFallbackLabel" Style="{StaticResource LabelStyle}" Text="Restore setpoint mL/min" />
                    <TextBox x:Name="AmcFallbackBox" Style="{StaticResource InputStyle}" />
                    <CheckBox x:Name="AmcForceDigitalModeBox" Content="Force AMC2100 digital mode before writing setpoint" Margin="0,0,0,14" />

                    <Button x:Name="SaveSettingsButton" Style="{StaticResource PrimaryButtonStyle}" Content="Save Settings" Click="SaveSettingsButton_Click" Margin="0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="320" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TextBlock x:Name="ChartGroupTitle" Text="Temperature Trend" Style="{StaticResource CardTitleStyle}" />
                  <Canvas x:Name="TemperatureChartCanvas" Grid.Row="1" Background="#FCFDFF" SizeChanged="TemperatureChartCanvas_SizeChanged" />
                </Grid>
              </Border>

              <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TextBlock x:Name="HistoryCardTitle" Text="History" Style="{StaticResource CardTitleStyle}" />
                  <DataGrid x:Name="HistoryGrid"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            HeadersVisibility="Column"
                            GridLinesVisibility="Horizontal"
                            RowHeaderWidth="0"
                            BorderThickness="0"
                            Background="Transparent">
                    <DataGrid.Columns>
                      <DataGridTextColumn x:Name="TimeColumn" Header="Time" Binding="{Binding Timestamp}" Width="180" />
                      <DataGridTextColumn x:Name="TemperatureColumn" Header="Temp C" Binding="{Binding TemperatureC}" Width="90" />
                      <DataGridTextColumn x:Name="StatusColumn" Header="Status" Binding="{Binding Status}" Width="110" />
                      <DataGridTextColumn x:Name="RelayColumn" Header="Relay" Binding="{Binding RelayAction}" Width="110" />
                      <DataGridTextColumn x:Name="ReasonColumn" Header="Reason" Binding="{Binding AlarmReason}" Width="*" />
                      <DataGridTextColumn x:Name="RoiColumn" Header="ROI" Binding="{Binding ScreenshotRoi}" Width="180" />
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem x:Name="G2000Tab" Header="G2000">
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.15*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <Border Style="{StaticResource CardBorderStyle}">
                  <StackPanel>
                    <TextBlock Text="G2000 控制状态 / G2000 Control Status" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="高压危险：HV EIN 与启动配方会让高压链进入工作状态。未接反应器或存在裸露电极时不要点击。&#10;High-voltage hazard: HV EIN and the startup recipe can energize the high-voltage chain. Do not use them with exposed electrodes." Foreground="#B00020" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Connection" Margin="0,0,12,8" />
                      <TextBlock x:Name="G2000ConnectionText" Grid.Row="0" Grid.Column="1" Text="Not connected" Margin="0,0,0,8" />
                      <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Source" Margin="0,0,12,8" />
                      <TextBlock x:Name="G2000SourceText" Grid.Row="1" Grid.Column="1" Text="--" Margin="0,0,0,8" />
                      <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Fault" Margin="0,0,12,8" />
                      <TextBlock x:Name="G2000FaultText" Grid.Row="2" Grid.Column="1" Text="--" Margin="0,0,0,8" />
                      <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Trip" Margin="0,0,12,8" />
                      <TextBlock x:Name="G2000TripText" Grid.Row="3" Grid.Column="1" Text="--" Margin="0,0,0,8" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="UI Mode" Margin="0,0,12,8" />
                      <TextBlock x:Name="G2000ModeText" Grid.Row="4" Grid.Column="1" Text="Manual" Margin="0,0,0,8" />
                      <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Auto Stage" Margin="0,0,12,0" />
                      <TextBlock x:Name="G2000AutoStageText" Grid.Row="5" Grid.Column="1" Text="Idle" TextWrapping="Wrap" />
                    </Grid>

                    <Button x:Name="G2000RefreshButton" Style="{StaticResource SecondaryButtonStyle}" Content="连接 / 刷新  Connect / Refresh" Click="G2000RefreshButton_Click" />
                    <Button x:Name="G2000HvAusButton" Style="{StaticResource SecondaryButtonStyle}" Content="HV AUS" Click="G2000HvAusButton_Click" />
                    <Button x:Name="G2000HvReadyButton" Style="{StaticResource SecondaryButtonStyle}" Content="HV bereit" Click="G2000HvReadyButton_Click" />
                    <Button x:Name="G2000HvEinButton" Style="{StaticResource PrimaryButtonStyle}" Content="HV EIN（高风险 / High Risk）" Click="G2000HvEinButton_Click" />
                    <Button x:Name="G2000ResetTripButton" Style="{StaticResource SecondaryButtonStyle}" Content="按恢复策略恢复  Recover According To Policy" Click="G2000ResetTripButton_Click" Margin="0" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                  <StackPanel>
                    <TextBlock Text="可写设定值 / Writable Setpoints" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="先点“写入设定值”，再进入 HV bereit / HV EIN。0x300 写入的是 U2 / Zwischenkreis（内部中间回路电压），不是外部高压输出端电压；设备可能因内部限制让实际值偏离设定值。&#10;Click “Apply Setpoints” before HV bereit / HV EIN. 0x300 writes U2 / Zwischenkreis (the internal DC-link voltage), not the external HV output voltage; the generator may clamp the actual value." Foreground="#7C2D12" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Style="{StaticResource LabelStyle}" Text="U2 / Zwischenkreis V" />
                    <TextBox x:Name="G2000VoltageBox" Style="{StaticResource InputStyle}" />
                    <TextBlock Style="{StaticResource LabelStyle}" Text="Frequency kHz" />
                    <TextBox x:Name="G2000FrequencyBox" Style="{StaticResource InputStyle}" />
                    <TextBlock Style="{StaticResource LabelStyle}" Text="Duty %" />
                    <TextBox x:Name="G2000DutyBox" Style="{StaticResource InputStyle}" />
                    <TextBlock Style="{StaticResource LabelStyle}" Text="Ton ms" />
                    <TextBox x:Name="G2000TonBox" Style="{StaticResource InputStyle}" />
                    <TextBlock Style="{StaticResource LabelStyle}" Text="Toff ms" />
                    <TextBox x:Name="G2000ToffBox" Style="{StaticResource InputStyle}" />
                    <Button x:Name="G2000ApplySetpointsButton" Style="{StaticResource PrimaryButtonStyle}" Content="写入设定值  Apply Setpoints" Click="G2000ApplySetpointsButton_Click" Margin="0,0,0,8" />
                    <Button x:Name="G2000ManualTwoStepButton" Style="{StaticResource SecondaryButtonStyle}" Content="运行已验证启动配方（U2: 63V -> 1s -> 43V） Run Verified Startup Recipe" Click="G2000ManualTwoStepButton_Click" Margin="0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <Border Style="{StaticResource CardBorderStyle}">
                  <StackPanel>
                    <TextBlock Text="自动启动配方 / Automatic Startup Recipe" Style="{StaticResource CardTitleStyle}" />
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Stage1 U2 V" />
                        <TextBox x:Name="G2000Stage1VoltageBox" Style="{StaticResource InputStyle}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Stage1 Duration ms" />
                        <TextBox x:Name="G2000Stage1DurationBox" Style="{StaticResource InputStyle}" />
                      </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource LabelStyle}" Text="Stage2 U2 V" />
                    <TextBox x:Name="G2000Stage2VoltageBox" Style="{StaticResource InputStyle}" />
                    <CheckBox x:Name="G2000Stage2HoldBox" Content="切换后保持第二阶段  Hold Stage2 after transition" Margin="0,0,0,8" />
                    <CheckBox x:Name="G2000EnterHvReadyBox" Content="启动前先进入 HV bereit  Enter HV bereit before recipe start" Margin="0,0,0,8" />
                    <CheckBox x:Name="G2000EnterHvOnBox" Content="启动时进入 HV EIN（高风险） Enter HV EIN when recipe starts" Margin="0,0,0,12" />
                    <TextBlock Style="{StaticResource LabelStyle}" Text="恢复策略 / Recovery Policy" />
                    <ComboBox x:Name="G2000RecoveryPolicyBox" Style="{StaticResource ComboStyle}" />
                    <Button x:Name="G2000StartAutomaticButton" Style="{StaticResource PrimaryButtonStyle}" Content="开始自动配方  Start Automatic Recipe" Click="G2000StartAutomaticButton_Click" />
                    <Button x:Name="G2000StopAutomaticButton" Style="{StaticResource SecondaryButtonStyle}" Content="停止自动配方  Stop Automatic Recipe" Click="G2000StopAutomaticButton_Click" Margin="0" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                  <StackPanel>
                    <TextBlock Text="目标值与实际值 / Targets And Actuals" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="注意：下面的 0x280 / U2 Actual 是内部中间回路实际值，不是外部高压输出端电压。手册还明确说明，实际可达到的值可能因为内部控制限制而偏离设定值。&#10;Note: 0x280 / U2 Actual is the internal DC-link actual, not the external HV output voltage. The manual also states that the achievable value can differ from the requested setpoint because of internal controller limits." Foreground="#7C2D12" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <TextBlock Grid.Row="0" Grid.Column="1" Text="Target" FontWeight="SemiBold" />
                      <TextBlock Grid.Row="0" Grid.Column="2" Text="Actual" FontWeight="SemiBold" />

                      <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="U2 Setpoint / 0x280 Actual V" Margin="0,0,12,8" />
                      <TextBlock x:Name="G2000TargetVoltageText" Grid.Row="1" Grid.Column="1" Text="--" Margin="0,0,0,8" />
                      <TextBlock x:Name="G2000ActualVoltageText" Grid.Row="1" Grid.Column="2" Text="--" Margin="0,0,0,8" />

                      <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Frequency kHz" Margin="0,0,12,8" />
                      <TextBlock x:Name="G2000TargetFrequencyText" Grid.Row="2" Grid.Column="1" Text="--" Margin="0,0,0,8" />
                      <TextBlock x:Name="G2000ActualFrequencyText" Grid.Row="2" Grid.Column="2" Text="--" Margin="0,0,0,8" />

                      <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Duty %" Margin="0,0,12,8" />
                      <TextBlock x:Name="G2000TargetDutyText" Grid.Row="3" Grid.Column="1" Text="--" Margin="0,0,0,8" />
                      <TextBlock x:Name="G2000ActualDutyText" Grid.Row="3" Grid.Column="2" Text="--" Margin="0,0,0,8" />

                      <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Ton ms" Margin="0,0,12,8" />
                      <TextBlock x:Name="G2000TargetTonText" Grid.Row="4" Grid.Column="1" Text="--" Margin="0,0,0,8" />
                      <TextBlock x:Name="G2000ActualTonText" Grid.Row="4" Grid.Column="2" Text="--" Margin="0,0,0,8" />

                      <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Toff ms" Margin="0,0,12,0" />
                      <TextBlock x:Name="G2000TargetToffText" Grid.Row="5" Grid.Column="1" Text="--" />
                      <TextBlock x:Name="G2000ActualToffText" Grid.Row="5" Grid.Column="2" Text="--" />
                    </Grid>

                    <TextBlock Style="{StaticResource LabelStyle}" Text="DC link aux actual" Margin="0,14,0,6" />
                    <TextBlock x:Name="G2000ActualAuxText" Text="--" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                  <StackPanel>
                    <TextBlock Text="原始 CAN 帧 / Raw CAN Frames" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Style="{StaticResource LabelStyle}" Text="0x180 Status" />
                    <TextBox x:Name="G2000Raw180Text" Style="{StaticResource InputStyle}" IsReadOnly="True" />
                    <TextBlock Style="{StaticResource LabelStyle}" Text="0x280 DC link actual" />
                    <TextBox x:Name="G2000Raw280Text" Style="{StaticResource InputStyle}" IsReadOnly="True" />
                    <TextBlock Style="{StaticResource LabelStyle}" Text="0x281 Inverter actual" />
                    <TextBox x:Name="G2000Raw281Text" Style="{StaticResource InputStyle}" IsReadOnly="True" />
                    <TextBlock Style="{StaticResource LabelStyle}" Text="0x380 Reserved raw" />
                    <TextBox x:Name="G2000Raw380Text" Style="{StaticResource InputStyle}" IsReadOnly="True" />
                    <TextBlock Style="{StaticResource LabelStyle}" Text="0x381 Pulse actual" />
                    <TextBox x:Name="G2000Raw381Text" Style="{StaticResource InputStyle}" IsReadOnly="True" Margin="0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <TabItem x:Name="EngineeringTab" Header="Engineering">
          <Grid Margin="0,10,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="18">
              <StackPanel>
                <TextBlock x:Name="EngineeringCardTitle" Text="Engineering / Interlock Test" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8" />
                <TextBlock x:Name="EngineeringChecklistText" Text="Checklist" TextWrapping="Wrap" Foreground="#334155" />
              </StackPanel>
            </Border>

            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.2*" />
              </Grid.ColumnDefinitions>

              <UniformGrid Grid.Column="0" Columns="2" Rows="2" Margin="0,0,0,12">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12">
                  <StackPanel>
                    <TextBlock x:Name="Channel1NameText" Text="CH1" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,6" />
                    <TextBlock x:Name="Channel1MappingText" Text="Interlock A negative (I1-I2)" Foreground="#475569" TextWrapping="Wrap" />
                    <TextBlock x:Name="Channel1StateText" Text="Unknown" Margin="0,12,0,12" FontWeight="SemiBold" Foreground="#0F172A" />
                    <Button x:Name="Channel1OpenButton" Style="{StaticResource SecondaryButtonStyle}" Tag="1" Content="Disconnect" Click="ChannelOpenButton_Click" />
                    <Button x:Name="Channel1CloseButton" Style="{StaticResource SecondaryButtonStyle}" Tag="1" Content="Connect" Click="ChannelCloseButton_Click" Margin="0" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock x:Name="Channel2NameText" Text="CH2" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,6" />
                    <TextBlock x:Name="Channel2MappingText" Text="Interlock A positive (I5-I6)" Foreground="#475569" TextWrapping="Wrap" />
                    <TextBlock x:Name="Channel2StateText" Text="Unknown" Margin="0,12,0,12" FontWeight="SemiBold" Foreground="#0F172A" />
                    <Button x:Name="Channel2OpenButton" Style="{StaticResource SecondaryButtonStyle}" Tag="2" Content="Disconnect" Click="ChannelOpenButton_Click" />
                    <Button x:Name="Channel2CloseButton" Style="{StaticResource SecondaryButtonStyle}" Tag="2" Content="Connect" Click="ChannelCloseButton_Click" Margin="0" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                  <StackPanel>
                    <TextBlock x:Name="Channel3NameText" Text="CH3" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,6" />
                    <TextBlock x:Name="Channel3MappingText" Text="Interlock B negative (I3-I4)" Foreground="#475569" TextWrapping="Wrap" />
                    <TextBlock x:Name="Channel3StateText" Text="Unknown" Margin="0,12,0,12" FontWeight="SemiBold" Foreground="#0F172A" />
                    <Button x:Name="Channel3OpenButton" Style="{StaticResource SecondaryButtonStyle}" Tag="3" Content="Disconnect" Click="ChannelOpenButton_Click" />
                    <Button x:Name="Channel3CloseButton" Style="{StaticResource SecondaryButtonStyle}" Tag="3" Content="Connect" Click="ChannelCloseButton_Click" Margin="0" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                  <StackPanel>
                    <TextBlock x:Name="Channel4NameText" Text="CH4" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,6" />
                    <TextBlock x:Name="Channel4MappingText" Text="Interlock B positive (I7-I8)" Foreground="#475569" TextWrapping="Wrap" />
                    <TextBlock x:Name="Channel4StateText" Text="Unknown" Margin="0,12,0,12" FontWeight="SemiBold" Foreground="#0F172A" />
                    <Button x:Name="Channel4OpenButton" Style="{StaticResource SecondaryButtonStyle}" Tag="4" Content="Disconnect" Click="ChannelOpenButton_Click" />
                    <Button x:Name="Channel4CloseButton" Style="{StaticResource SecondaryButtonStyle}" Tag="4" Content="Connect" Click="ChannelCloseButton_Click" Margin="0" />
                  </StackPanel>
                </Border>
              </UniformGrid>

              <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardBorderStyle}">
                  <StackPanel>
                    <TextBlock x:Name="EngineeringActionsTitle" Text="Grouped Actions" Style="{StaticResource CardTitleStyle}" />
                    <Button x:Name="TripAllEngineeringButton" Style="{StaticResource PrimaryButtonStyle}" Content="Disconnect All Interlocks" Click="TestRelayButton_Click" />
                    <Button x:Name="RestoreAllEngineeringButton" Style="{StaticResource SecondaryButtonStyle}" Content="Connect All Interlocks" Click="TestRelayResetButton_Click" />
                    <Separator Margin="0,6,0,12" />
                    <Button x:Name="StopGasButton" Style="{StaticResource SecondaryButtonStyle}" Content="Stop Gas Flow" Click="StopGasButton_Click" />
                    <Button x:Name="RestoreGasButton" Style="{StaticResource SecondaryButtonStyle}" Content="Restore Gas Flow" Click="RestoreGasButton_Click" />
                    <Button x:Name="RestoreMonitoringControlButton" Style="{StaticResource SecondaryButtonStyle}" Content="Restore Monitoring Control" Click="RestoreMonitoringControlButton_Click" Margin="0" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                  <StackPanel>
                    <TextBlock x:Name="EngineeringNotesTitle" Text="Wiring Notes" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock x:Name="EngineeringNotesText" Text="Software-side state only. Confirm relay movement and interlock continuity with a multimeter." TextWrapping="Wrap" Foreground="#475569" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Grid>
        </TabItem>
      </TabControl>

      <TextBlock x:Name="FooterText" Grid.Row="2" Margin="2,14,2,0" Foreground="#475569" Text="Ready." />
    </Grid>
  </DockPanel>
</Window>
