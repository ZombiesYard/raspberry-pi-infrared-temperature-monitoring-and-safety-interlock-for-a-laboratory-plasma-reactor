<Window x:Class="ReactorSoftInterlock.Wpf.GitLabUploadSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="570" MinWidth="500" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F4F7FB">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" Foreground="#13213C" />
      <TextBlock x:Name="DescriptionText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#526178" />
    </StackPanel>

    <Border Grid.Row="1" Background="White" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="8" Padding="18">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <CheckBox x:Name="AutoUploadBox" Margin="0,0,0,16" />

          <TextBlock x:Name="BaseUrlLabel" Margin="0,0,0,4" FontWeight="SemiBold" />
          <TextBox x:Name="BaseUrlBox" Margin="0,0,0,12" Padding="8" />

          <TextBlock x:Name="ProjectIdLabel" Margin="0,0,0,4" FontWeight="SemiBold" />
          <TextBox x:Name="ProjectIdBox" Margin="0,0,0,12" Padding="8" />

          <TextBlock x:Name="PackageNameLabel" Margin="0,0,0,4" FontWeight="SemiBold" />
          <TextBox x:Name="PackageNameBox" Margin="0,0,0,12" Padding="8" />

          <TextBlock x:Name="CredentialTargetLabel" Margin="0,0,0,4" FontWeight="SemiBold" />
          <TextBox x:Name="CredentialTargetBox" Margin="0,0,0,12" Padding="8" IsReadOnly="True" Background="#EEF2F7" />

          <TextBlock x:Name="TokenLabel" Margin="0,0,0,4" FontWeight="SemiBold" />
          <PasswordBox x:Name="TokenBox" Margin="0,0,0,8" Padding="8" />
          <TextBlock x:Name="TokenHintText" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="#526178" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="StoreCredentialButton" MinWidth="130" Padding="12,7" Margin="0,0,8,0" Click="StoreCredentialButton_Click" />
            <Button x:Name="ClearCredentialButton" MinWidth="130" Padding="12,7" Click="ClearCredentialButton_Click" />
          </StackPanel>
          <TextBlock x:Name="CredentialStatusText" Margin="0,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="CancelButton" MinWidth="100" Padding="12,8" Margin="0,0,8,0" IsCancel="True" />
      <Button x:Name="SaveButton" MinWidth="120" Padding="12,8" IsDefault="True" Click="SaveButton_Click" />
    </StackPanel>
  </Grid>
</Window>
